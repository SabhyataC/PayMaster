# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox credentials: REST app "paymaster-us" (Business, US) in the developer dashboard
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Local Postgres (used by docker-compose.yml)
POSTGRES_USER=paymaster
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=paymaster
DATABASE_URL=postgresql://paymaster:choose-a-password@localhost:5433/paymaster

# Webhook ID shown in the PayPal dashboard after you register your webhook URL
PAYPAL_WEBHOOK_ID=your-webhook-id

# Sessions: at least 32 random characters, for example the output of: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-random-string-of-at-least-32-characters

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Optional second model used when the first is overloaded
GEMINI_FALLBACK_MODEL=

# Exact origins the console is served from (comma separated). "*" is refused.
CONSOLE_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional
SIGNUP_ENABLED=false
TRUST_PROXY=false
COOKIE_SAMESITE=lax
PAYPAL_ACCOUNT_EMAIL=

# Alerts (optional). Admins set recipients in the console under Team > Alerts.
# Email (for Gmail use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# WhatsApp through Twilio (sandbox is fine for a demo: each phone first sends the join code to the sandbox number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Used for the "Open: ..." link in alerts, for example https://your-demo.example.com/console
CONSOLE_URL=
